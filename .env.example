# Copy to .env and set a random secret (at least 32 characters).
SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters
POSTGRES_PASSWORD=reclipd-local-dev
DATABASE_URL=postgresql+psycopg://reclipd:reclipd-local-dev@db:5432/reclipd
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/data
CORS_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false
MAX_UPLOAD_MB=2048
MAX_MEDIA_SECONDS=3600
FREE_MINUTES=120
WHISPER_MODEL=base
# Greedy decoding favors CPU speed; set 5 for slower beam-search decoding.
WHISPER_BEAM_SIZE=1
WHISPER_CPU_THREADS=2
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Direct media imports require an operator-controlled HTTPS hostname allowlist.
IMPORT_ALLOWED_HOSTS=[]
# Optional OpenAI-compatible LOCAL LLM service; never exposed to frontend.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional local Pyannote pipeline (requires requirements-diarization.txt).
SPEAKER_MODEL_PATH=
# Server-side YouTube Data API v3 key: metadata only, never audiovisual download access.
YOUTUBE_API_KEY=

# Optional unofficial public-video retrieval; requires user media rights.
YOUTUBE_DOWNLOAD_ENABLED=false
YOUTUBE_DOWNLOAD_TIMEOUT=600

# Account IDs exempt from processing-minute quotas; operational limits still apply.
UNLIMITED_USER_IDS=[]

# Sandbox only. Live keys are rejected. Never expose the secret to Vite.
PAYSTACK_SECRET_KEY=
BILLING_RETURN_URL=http://localhost:5173/studio/billing
# Prices are integer KES; configure your approved packs, e.g. an array of
# {"id":"pack-id","name":"Package name","amount_kes":YOUR_PRICE,"minutes":YOUR_MINUTES}
BILLING_PACKS=[]

# Password-reset email (Gmail app password for local development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_URL=http://localhost:5173

# PayPal sandbox only. All credentials stay on the server.
PAYPAL_SANDBOX_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=

# Optional VideoScale cloud retrieval (secrets stay server-side).
VIDEOSCALE_ENABLED=false
VIDEOSCALE_AUTH_HEADER=
# Lifetime conservative byte reservation; 0 disables transfers. No auto-renewal/top-up.
VIDEOSCALE_BUDGET_BYTES=0
VIDEOSCALE_MAX_IMPORT_MB=512
